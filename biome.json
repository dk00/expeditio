{
	"linter": {
		"includes": ["src/**/*.jsx", "src/**/*.js"],
		"rules": {
      "a11y": "info",
			"correctness": {
				"noUndeclaredVariables": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"indentStyle": "space",
			"semicolons": "asNeeded",
			"bracketSpacing": false,
			"quoteStyle": "single",
			"arrowParentheses": "asNeeded"
		}
	},
	  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
